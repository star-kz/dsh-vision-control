{
  "name": "@k-launcher/dsh-vision-control",
  "version": "3.0.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "star-kz",
  "repository": {
    "type": "git",
    "url": "https://github.com/star-kz/dsh-vision-control.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test",
    "build:native": "node tools/build-native.mjs",
    "pack:candidate": "node tools/pack-candidate.mjs",
    "pack:candidate:native": "npm run build:native && npm run pack:candidate"
  },
  "description": "DSH-Vision-Control 3.0：禁用、仅观看、观看+操作三态实时视觉与桌面操控，按模式隔离工具、提示词和执行权限。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1,
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0",
      "node": ">=20",
      "systems": [
        "win32"
      ],
      "profiles": [
        "desktop"
      ],
      "dshReleases": {
        "0.2.1-rc.1": "unknown",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      },
      "dshOperations": {
        "0.2.1-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-rc.3": {
          "install": "passed",
          "start": "passed",
          "uninstall": "unknown",
          "rollback": "unknown"
        }
      }
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "REALTIME.md",
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "release-manifest.json",
    "backend",
    "browser",
    "internal",
    "see",
    "skills",
    "tools",
    "realtime",
    "native"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-scope": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
