<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Rt.Windows</RootNamespace>
    <Description>Windows adapters for the realtime vision runtime: QPC timing and real WGC/D3D11 shadow capture.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rt.Core\Rt.Core.csproj" />
    <!-- SharpDX 4.2.0 supplies the D3D11 texture/readback interop; no image or input packages. -->
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <!-- Pin patched assets above SharpDX's legacy NETStandard.Library 1.6.1 chain.
         On net8.0 these resolve to the shared framework and are not shipped as extra DLLs. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

</Project>
