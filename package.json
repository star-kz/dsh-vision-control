{
  "name": "@k-launcher/dsh-vision-control",
  "version": "1.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "star-kz",
  "repository": { "type": "git", "url": "https://github.com/star-kz/dsh-vision-control.git" },
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "description": "DSH-Vision-Control（dsh-视-驭）：实时视觉感知 + 精确桌面操控。computer_* 操控工具族 + computer_watch 实时屏幕感知，composer 工具栏芯片一键授权。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1,
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0",
      "node": ">=20",
      "systems": [
        "win32"
      ],
      "profiles": [
        "desktop"
      ],
      "dshReleases": {
        "0.2.1-rc.1": "unknown",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      },
      "dshOperations": {
        "0.2.1-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-rc.3": {
          "install": "passed",
          "start": "passed",
          "uninstall": "unknown",
          "rollback": "unknown"
        }
      }
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE",
    "backend",
    "browser",
    "internal",
    "see",
    "skills",
    "tools"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-scope": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
